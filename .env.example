# Gram Academy — frontend (Vite) env. Copy to `.env` and fill.
# Only public VITE_* values belong here (they ship in the browser bundle).
# The referral link is built server-side and returned by the API — the client
# never assembles it, so there is no VITE_BOT_USERNAME / VITE_TMA_SHORT_NAME.
VITE_API_BASE_URL=/api
VITE_TON_NETWORK=testnet
VITE_TONCONNECT_MANIFEST_URL=
VITE_TMA_PUBLIC_URL=
VITE_ACADEMY_COLLECTION_ADDRESS=
VITE_TELEGRAM_BOT_DEEPLINK=
