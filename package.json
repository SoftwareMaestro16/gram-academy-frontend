{
  "name": "@gram-academy/tma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gram Academy — Telegram Mini App (React + Vite). Vendors @gram-academy/protocol and @gram-academy/i18n.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "sync:vendored": "node tools/sync-vendored.mjs"
  },
  "dependencies": {
    "@gram-academy/i18n": "0.1.0",
    "@gram-academy/protocol": "0.1.0",
    "@tanstack/react-query": "^5.85.5",
    "@tma.js/sdk-react": "^3.0.23",
    "@ton/core": "^0.63.1",
    "@tonconnect/ui-react": "^3.0.2",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  }
}
